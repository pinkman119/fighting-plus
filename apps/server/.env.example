# fighting-plus-server 环境变量示例（复制为 .env 后按需修改；脚本不会自动加载，需在启动环境中导出）

# NestJS 监听端口
PORT=3118

# 流媒体引擎：builtin=内置 RTMP 服务（默认，无需 Docker）；srs=使用外部 SRS
MEDIA_ENGINE=builtin
# 内置 RTMP 服务端口（OBS 推流地址 rtmp://<主机IP>:1935/live）
RTMP_PORT=1935
# 内置 HTTP-FLV 端口（经 NestJS /live/* 同源代理）
MEDIA_HTTP_PORT=8080

# SRS HTTP API：使用外部 SRS 时查询在线流（Docker 内的 SRS 映射到本机 1985）
SRS_API_URL=http://127.0.0.1:1985
# SRS 轮询间隔（毫秒）
SRS_POLL_INTERVAL_MS=2000
# SRS HTTP 流服务：HTTP-FLV / HLS，由服务端同源代理到 /live/**
SRS_HTTP_URL=http://127.0.0.1:8080

# OBS 推流服务器地址；留空时按请求 Host 推导为 rtmp://<host-ip>:1935/live
RTMP_PUSH_SERVER=

# 导播 OBS 的 WebSocket（可选，用于 /api/obs/*）
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=

# Web 端构建产物目录；留空时使用 apps/frontend/dist
WEB_DIST=
