{
  "name": "fighting-plus-client",
  "version": "1.0.4",
  "private": true,
  "description": "fighting-plus 桌面客户端 (Electron)，渲染层复用 apps/frontend",
  "main": "out/main/index.js",
  "author": "fighting-plus",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "package:win": "electron-vite build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^6.0.0",
    "typescript": "~5.7.2",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.fightingplus.app",
    "productName": "fighting-plus",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
