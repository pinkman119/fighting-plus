# fighting-plus server 环境变量示例（复制为 .env 后修改）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fighting_plus
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
REFRESH_EXPIRES_DAYS=7
PORT=3000
UPLOAD_DIR=./uploads
PUBLIC_URL=http://localhost:3000
# 生产环境开启 TLS（配合反代或直连证书）
USE_TLS=false
TLS_CERT=
TLS_KEY=
