{
  "name": "fighting-plus-client",
  "version": "0.1.0",
  "private": true,
  "description": "fighting-plus 桌面客户端 (Electron + Vue 3)",
  "main": "out/main/index.js",
  "author": "fighting-plus",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "package:win": "electron-vite build && electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "konva": "^9.3.16",
    "pinia": "^2.3.0",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.13",
    "vue-konva": "^3.1.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vue-tsc": "^2.1.10"
  },
  "build": {
    "appId": "com.fightingplus.app",
    "productName": "fighting-plus",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
